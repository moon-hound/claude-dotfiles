# Personal Assistant - Environment Configuration Template
# Copy to .env or set in system environment

# ============================================================================
# Error Reporting (Sentry)
# ============================================================================
# Optional - leave unset for local development
# Get DSN from: https://sentry.io/settings/projects/personal-assistant/keys/
SENTRY_DSN=

# Environment name (development, staging, production)
ENVIRONMENT=development

# Version/release (git commit SHA or semantic version)
VERSION=1.0.0

# ============================================================================
# Logging
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# AWS Bedrock (for Claude API)
# ============================================================================
# Configured via ~/.claude/settings.local.json typically
# ANTHROPIC_BEDROCK_BASE_URL=https://bedrock-runtime.us-west-2.amazonaws.com
# ANTHROPIC_AUTH_TOKEN=your-token-here
# AWS_BEARER_TOKEN_BEDROCK=your-bearer-token
# AWS_REGION=us-west-2

# ============================================================================
# Slack Tokens
# ============================================================================
# Stored in OS-native secure storage (Keychain/Credential Manager/Secret Service)
# NOT in environment variables for security
# Run: python3 ~/.claude/skills/work-vault/scripts/save-tokens.py

# ============================================================================
# Google OAuth (Optional - for Gmail/Calendar integration)
# ============================================================================
# Stored in OS-native secure storage
# Run: python3 ~/.claude/skills/work-vault/scripts/google_oauth.py setup
